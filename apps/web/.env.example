# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.

# Postgres connection string. Matches infra/docker-compose.yml by default.
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/erp_dev"

# Financial Modeling Prep API key (free tier). Sign up at
# https://site.financialmodelingprep.com/register — powers company search
# and the company overview page.
FMP_API_KEY=""

# SEC EDGAR requires every request to identify the requester (name + contact
# email) — see https://www.sec.gov/os/webmaster-faq#developers. No signup or
# key needed, just set this to something real; SEC rate-limits or blocks
# generic/missing User-Agents. Powers financial statement data and SEC
# Filing Intelligence (Milestone 7).
SEC_USER_AGENT="Atlas Research yourname@example.com"

# Anthropic API key (Claude) — powers SEC Filing Intelligence's AI analysis
# (executive summaries, risk flags, filing comparisons). Sign up at
# https://console.anthropic.com/. Without it, filing retrieval/processing/
# search all still work — only AI-generated analysis is unavailable, and the
# UI clearly labels this rather than fabricating an analysis.
ANTHROPIC_API_KEY=""

# Which Claude model performs filing analysis — tracked per-analysis in the
# database so a later model upgrade can be identified and analyses
# regenerated deliberately, not silently mixed.
ANTHROPIC_MODEL="claude-sonnet-4-5"
